# AIAgentClassSelect personal edition: optional settings for docker compose.
#   cp .env.example .env     then edit .env (docker compose reads .env from this folder automatically).
# Every setting has a working default, so .env is optional. Nothing here is a secret: there are no API keys,
# accounts or cloud services. .env is git-ignored; keep machine-specific choices there, not in docker-compose.yml.
# Variables already set in your shell (e.g. `export AI_MODEL=...`) take precedence over this file.

# ---- Network ----
# Port of the app in the browser: http://localhost:3000 on the Mac, http://<Mac LAN IP>:3000 on the iPhone.
FRONTEND_PORT=3000
# Where the app is reachable. Empty (default) = this Mac and devices on the same Wi-Fi (no login; anyone on
# the network can use it). 127.0.0.1 = this Mac only.
FRONTEND_BIND=
# Backend API port on this Mac. It is always published on 127.0.0.1 only (never to the network).
BACKEND_PORT=8000

# ---- AI Assistant (local Ollama on this Mac; optional) ----
# false: Discover, Saved and Settings work; the AI Assistant tab reports that it is turned off.
AI_ENABLED=true
# A tool-calling model you have pulled with `ollama pull`. See docs/INSTALL_MAC.md for a choice by Mac memory.
AI_MODEL=qwen2.5:1.5b
# How the backend container reaches the Ollama app on this Mac. Ollama keeps listening on 127.0.0.1:11434;
# Docker Desktop forwards host.docker.internal to it. Change only if Ollama runs on another port.
AI_BASE_URL=http://host.docker.internal:11434
# Seconds to wait for one model reply. Raise it (e.g. 300) for larger models or Intel Macs.
AI_TIMEOUT=120
# Maximum model calls per question (each may run activity searches).
AI_MAX_ITERATIONS=5
